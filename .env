# JWT
JWT_SECRET_KEY=placeholder-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=finsolve_chunks

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-super:cloud

# BGE-M3
EMBEDDING_MODEL=BAAI/bge-m3

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=placeholder-langsmith-key
LANGCHAIN_PROJECT=finsolve-rag

# NeMo Guardrails
NEMO_CONFIG_PATH=./guardrails/nemo_config

# Monitoring
AUDIT_LOG_PATH=./logs/audit.jsonl